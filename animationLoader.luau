-- ==========================================
-- 核心逻辑：拉取动画并写入 Workspace.Animation_1
-- ==========================================

local AnimScanner = {}

function AnimScanner.FetchAnim(animName, assetId)
    -- 1. 优先通过 AnimationClipProvider 获取动画实例
    local ok, clip = pcall(function()
        return AnimationClipProvider:GetAnimationClipAsync(assetId)
    end)

    -- 若首次缓存返回空关键帧则重试一次
    if ok and clip and clip:IsA("KeyframeSequence") and #clip:GetKeyframes() == 0 then
        ok, clip = pcall(function()
            return AnimationClipProvider:GetAnimationClipAsync(assetId)
        end)
    end

    -- 2. 备用：KeyframeSequenceProvider
    if not (ok and clip) then
        ok, clip = pcall(function()
            return KeyframeSequenceProvider:GetKeyframeSequenceAsync(assetId)
        end)
    end

    if ok and clip then
        local cloned = clip:Clone()
        cloned.Name = animName
        cloned:SetAttribute("AssetId", assetId)
        return true, cloned
    end

    return false, tostring(clip)
end

function AnimScanner.Init()
    -- 1. 在 Workspace 创建或获取 "Animation_1" 文件夹
    local rootFolder = Workspace:FindFirstChild(Config.OutputFolderName)
    if not rootFolder then
        rootFolder = Instance.new("Folder")
        rootFolder.Name = Config.OutputFolderName
        rootFolder.Parent = Workspace
    end

    -- 2. 收集并排序所有宠物名称
    local petNames = {}
    for petName, anims in pairs(AnimData) do
        if type(petName) == "string" and type(anims) == "table" then
            table.insert(petNames, petName)
        end
    end
    table.sort(petNames)

    print(string.format("[AnimScanner] 共 %d 个宠物动画组待处理...", #petNames))

    -- 3. 遍历配置并生成对应节点
    local successPets = 0
    local totalAnimsSuccess = 0

    for index, petName in ipairs(petNames) do
        local animMap = AnimData[petName]

        -- 在 Animation_1 下创建宠物同名文件夹 (如 Yutyrannus)
        local petFolder = rootFolder:FindFirstChild(petName)
        if not petFolder then
            petFolder = Instance.new("Folder")
            petFolder.Name = petName
            petFolder.Parent = rootFolder
        end

        -- 依次处理 idleAnim / walkAnim 等节点
        local animKeys = {}
        for animName in pairs(animMap) do
            table.insert(animKeys, animName)
        end
        table.sort(animKeys)

        local petSuccessCount = 0
        for _, animName in ipairs(animKeys) do
            local assetId = animMap[animName]
            if type(assetId) == "string" and assetId ~= "" then
                local existing = petFolder:FindFirstChild(animName)
                if existing then
                    existing:Destroy()
                end

                local ok, result = AnimScanner.FetchAnim(animName, assetId)
                if Config.RequestDelay > 0 then
                    task.wait(Config.RequestDelay)
                end

                if ok and result then
                    result.Parent = petFolder
                    petSuccessCount += 1
                    totalAnimsSuccess += 1
                    print(string.format("[%d/%d] 成功获取: %-15s -> %-10s (%s)", index, #petNames, petName, animName, result.ClassName))
                else
                    warn(string.format("[%d/%d] 获取失败: %-15s -> %-10s (原因: %s)", index, #petNames, petName, animName, tostring(result)))
                end
            end
        end

        if petSuccessCount > 0 then
            successPets += 1
        end
    end

    print(string.format("[AnimScanner] 全部处理完成！成功处理 %d / %d 个宠物组，共生成 %d 个动画节点。", successPets, #petNames, totalAnimsSuccess))
    return true
end

-- 启动执行
AnimScanner.Init()